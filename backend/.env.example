# Match Sport 24 backend - required environment variables
# Copy this file to .env for local runs, or set these in your hosting
# platform's dashboard (Railway/Render: Project > Variables).

# --- REQUIRED: app will not start without these ---
MONGO_URL=mongodb+srv://user:password@your-cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=padel_finder_app
JWT_SECRET_KEY=replace-with-a-long-random-secret

# --- Stripe (club Premium subscriptions) ---
STRIPE_API_KEY=sk_live_...
# From Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret.
# Required for the webhook signature to be verified - without it, /api/webhook/stripe
# still works but logs a warning and accepts unsigned requests (not secure for production).
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Gmail SMTP (password reset emails) ---
SMTP_EMAIL=your-app@gmail.com
# Use a Gmail App Password (Google Account > Security > App Passwords), not your normal password.
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Misc ---
APP_NAME=Match Sport 24
